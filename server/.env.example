# HisabBook Backend Environment Variables (Example)
# Copy this file to .env and fill in your values.

PORT=5000
NODE_ENV=production

# Frontend Origin URL (for CORS)
CLIENT_URL=https://hisabbook-sigma.vercel.app

# MongoDB Atlas Connection URI
MONGODB_URI=<MongoDB Atlas connection string>

# Firebase Admin SDK Configuration (hisabbook-e2542)
FIREBASE_PROJECT_ID=hisabbook-e2542
FIREBASE_SERVICE_ACCOUNT=<service account JSON or supported credential format>
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
