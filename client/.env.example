# HisabBook Frontend Environment Variables (Example)
# Copy this file to .env and fill in your values.

# Backend API URL (Vercel -> Render production deployment)
VITE_API_URL=https://hisabbook-dajh.onrender.com/api

# Firebase Web App Configuration (hisabbook-e2542)
VITE_FIREBASE_API_KEY=<Firebase Web API key>
VITE_FIREBASE_AUTH_DOMAIN=hisabbook-e2542.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hisabbook-e2542
VITE_FIREBASE_STORAGE_BUCKET=<value from Firebase Web App config>
VITE_FIREBASE_MESSAGING_SENDER_ID=<value from Firebase Web App config>
VITE_FIREBASE_APP_ID=<value from Firebase Web App config>
