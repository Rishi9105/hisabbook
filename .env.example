# ======================================================
# HisabBook — Environment Variables Reference
# ======================================================
# Copy the relevant section to client/.env or server/.env
# NEVER commit real .env files to Git.

# --- Frontend (client/.env) ---
# VITE_API_URL=https://hisabbook-dajh.onrender.com/api
# VITE_FIREBASE_API_KEY=<Firebase Web API key>
# VITE_FIREBASE_AUTH_DOMAIN=hisabbook-e2542.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=hisabbook-e2542
# VITE_FIREBASE_STORAGE_BUCKET=<value from Firebase Web App config>
# VITE_FIREBASE_MESSAGING_SENDER_ID=<value from Firebase Web App config>
# VITE_FIREBASE_APP_ID=<value from Firebase Web App config>

# --- Backend (server/.env) ---
# PORT=5000
# NODE_ENV=production
# CLIENT_URL=https://hisabbook-sigma.vercel.app
# MONGODB_URI=<MongoDB Atlas connection string>
# FIREBASE_PROJECT_ID=hisabbook-e2542
# FIREBASE_SERVICE_ACCOUNT=<service account JSON or supported credential format>
